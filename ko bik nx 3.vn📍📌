local function doSwap(originalText)
    if type(originalText) ~= "string" then return originalText end
    
    local newText = originalText
    local changed = false
    
    if newText:lower():find("kaka hub") then
        newText = newText:gsub("[kK][aA][kK][aA] [hH][uU][bB]", "V.Đạt Yêu N.Huy")
        changed = true
    end
    
    if newText:lower():find("by nana") then
        newText = newText:gsub("[bB][yY] [nN][aA][nN][aA] [mM][aA][kK][eE]", "Blox Fruits")
        newText = newText:gsub("[bB][yY] [nN][aA][nN][aA] [mM][aA][kK][eE]", "Blox Fruits")
        changed = true
    end
    
    if changed then return newText end
    return originalText
end

local mt = getrawmetatable(game)
local old_newindex = mt.__newindex
setreadonly(mt, false)

mt.__newindex = newcclosure(function(self, property, value)
    if tostring(property) == "Text" and type(value) == "string" then
        value = doSwap(value)
    end
    return old_newindex(self, property, value)
end)
setreadonly(mt, true)

local function scanAndSwap(guiContainer)
    if not guiContainer then return end
    for _, desc in pairs(guiContainer:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            desc.Text = doSwap(desc.Text)
        end
    end
end

task.spawn(function() scanAndSwap(pGui) end)
