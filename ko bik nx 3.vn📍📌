    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if success then scanAndSwap(coreGui) end
    
    local success2, exploitGui = pcall(function() return gethui() end)
    if success2 then scanAndSwap(exploitGui) end
end)

local TRANSLATIONS = {
    ["DRAGON"] = "V.ĐẠT ",
    ["Sixth Realm Gun"] = "Bón Cứk",
    ["Farm"] = "A"
}
local MARKER = "\226\128\142"

local function processText(obj)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end
    
    local currentText = obj.Text
    if currentText == "" or string.find(currentText, MARKER) then return end
    
    local replacement = TRANSLATIONS[currentText]
    if replacement then
        obj.Text = replacement .. MARKER
    end
end

local function connectObj(d)
    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
        processText(d)
        d:GetPropertyChangedSignal("Text"):Connect(function()
            processText(d)
        end)
    end
end

