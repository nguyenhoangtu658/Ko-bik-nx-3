local oldId = "137357816768732"
local newId = "rbxassetid://133881391844406"

local function fixImage(obj)
	pcall(function()
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			if tostring(obj.Image):find(oldId) then obj.Image = newId end
			obj:GetPropertyChangedSignal("Image"):Connect(function()
				if tostring(obj.Image):find(oldId) then obj.Image = newId end
			end)
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			if tostring(obj.Texture):find(oldId) then obj.Texture = newId end
			obj:GetPropertyChangedSignal("Texture"):Connect(function()
				if tostring(obj.Texture):find(oldId) then obj.Texture = newId end
			end)
		elseif obj:IsA("MeshPart") then
			if tostring(obj.TextureID):find(oldId) then obj.TextureID = newId end
			obj:GetPropertyChangedSignal("TextureID"):Connect(function()
				if tostring(obj.TextureID):find(oldId) then obj.TextureID = newId end
			end)
		end
	end)
end

